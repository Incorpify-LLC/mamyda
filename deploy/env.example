# Copy to .env on pi03. .env is gitignored. Do not commit it.
# The image does not contain this file. Compose reads it at runtime.

POSTGRES_PASSWORD=change-me
BETTER_AUTH_URL=https://mamyda.incorpify.in
BETTER_AUTH_SECRET=at-least-32-characters-change-me
APP_URL=https://mamyda.incorpify.in

TUNNEL_TOKEN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
MAIL_FROM=Mamyda <alerts@mamyda.incorpify.in>

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# MinIO on pi06, reached over the home network. Same names point at AWS S3 later.
S3_ENDPOINT=http://pi06:9000
S3_BUCKET=mamyda
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# New encrypted assets use a separate bucket-scoped identity. Leave the endpoint
# unset until a private app-to-pi06 path exists; do not reuse MinIO root keys.
VAULT_S3_ENDPOINT=
VAULT_S3_BUCKET=mamyda
VAULT_S3_ACCESS_KEY=
VAULT_S3_SECRET_KEY=
VAULT_S3_REGION=us-east-1

# Optional host path for the database. Leave unset to use a Docker volume.
# Optional dedicated server encryption secret for saved LLM API keys (32+ characters).
# Falls back to BETTER_AUTH_SECRET. Back up securely; changing it requires re-entering keys.
LLM_CREDENTIAL_ENCRYPTION_KEY=
# Private temporary recordings (never MinIO). Compose mounts a shared local volume.
# The media worker requires the same LLM credential encryption material as the app.
# Do not include this volume in long-term backups; cleanup expires media after 15 days.
MEDIA_TEMP_DIR=/var/lib/mamyda-recordings
# Optional model ID for the existing server-wide xAI fallback.
XAI_MODEL=
# POSTGRES_DATA=/mnt/ssd/mamyda-pg
